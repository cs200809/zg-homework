# ===== Android 签名配置模板 =====
# 复制为 android/key.properties 后填入真实值：
#   cp android/key.properties.example android/key.properties
#
# key.properties 含真实密钥信息，已被 .gitignore 排除，严禁提交。
# 该文件不存在时，release 构建会退回 debug 签名（仅供内部测试，不可上架）；
# scripts/build.sh 的 check_android_signing 会给出同样的告警。
#
# storeFile 的相对路径以 android/ 目录为基准。

storePassword=在这里填入keystore密码
keyPassword=在这里填入密钥密码
keyAlias=在这里填入密钥别名
storeFile=../upload-keystore.jks
