# ===== zg-tsp-server 配置样例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# .env 含真实配置，禁止提交（已在 .gitignore 中）

# --- 应用 ---
APP_NAME=zg-tsp-server
ENV=dev                      # dev / test / prod
DEBUG=true
# 监听地址与端口由 uvicorn 命令行决定，不走环境变量：
#   uvicorn app.main:app --host 0.0.0.0 --port 8000

# --- 数据库 ---
# MySQL。字符集必须 utf8mb4，否则中文与 emoji 会乱码。
# 若从 JDBC URL 转换：mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:12345678@127.0.0.1:3306/zg_tsp?charset=utf8mb4
DB_ECHO=false

# --- JWT ---
# 生产环境务必修改；JWT 有效期 7 天
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# --- 初始化种子 ---
# 首次启动时若无 admin 则创建；留空则随机生成并打印到日志
ADMIN_INIT_PASSWORD=

# --- CORS ---
# 允许的客户端来源，逗号分隔（Web 端地址）
CORS_ORIGINS=http://localhost:5173

# --- 文件上传 ---
UPLOAD_DIR=./app/uploads
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# --- 安全 ---
# 注册接口限流：每分钟每 IP
REGISTER_RATE_LIMIT=10
# 签到/提交类接口限流：每分钟每用户
ACTION_RATE_LIMIT=10