# ===== zg-tsp-server 配置样例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# .env 含真实配置，禁止提交（已在 .gitignore 中）

# --- 应用 ---
APP_NAME=zg-tsp-server
ENV=dev                      # dev / test / prod
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- 数据库 ---
# SQLite（MVP），相对本模块目录
DATABASE_URL=sqlite:///./app/data/zg_tsp.db

# --- JWT ---
# 生产环境务必修改；JWT 有效期 7 天
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# --- 初始化种子 ---
# 首次启动时若无 admin 则创建；留空则随机生成并打印到日志
ADMIN_INIT_PASSWORD=

# --- CORS ---
# 允许的客户端来源，逗号分隔（Web 端地址）
CORS_ORIGINS=http://localhost:5173

# --- 文件上传 ---
UPLOAD_DIR=./app/uploads
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# --- 安全 ---
# 注册接口限流：每分钟每 IP
REGISTER_RATE_LIMIT=10
# 签到/提交类接口限流：每分钟每用户
ACTION_RATE_LIMIT=10