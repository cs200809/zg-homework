# Replace placeholders before installing as zg-homework-server.service.
# Paths and port must match the controller's ROOT, SERVER_PYTHON and SERVER_PORT.
# The service user needs access to the module .env and persistent upload paths.
[Unit]
Description=zg-homework server
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__SERVER_MODULE_DIR__
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__SERVER_PYTHON__ -m uvicorn app.main:app --host 127.0.0.1 --port __SERVER_PORT__ --workers 1
KillMode=control-group

[Install]
WantedBy=multi-user.target
