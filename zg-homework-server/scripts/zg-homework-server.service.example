# Replace placeholders before installing as zg-homework-server.service.
# Paths and port must match the controller's ROOT, SERVER_PYTHON and SERVER_PORT.
# The service user needs access to the environment file and persistent upload paths.
[Unit]
Description=zg-homework server
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/apps/zg-homework-server
#指向专属配置
EnvironmentFile=/etc/zg-homework-server/env
Environment=ZG_HOMEWORK_SYSTEMD_PRODUCTION=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/data/apps/zg-homework-server/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
KillMode=control-group

[Install]
WantedBy=multi-user.target
