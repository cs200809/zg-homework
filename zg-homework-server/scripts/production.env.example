# Install as /etc/zg-homework-server/env without overwriting an existing file.
# Replace every __PLACEHOLDER__; restrict access to administrators and the service user.
# Use one KEY=value per line, with keys limited to uppercase application settings.
# Values cannot contain quotes, backslashes, $, control characters, or leading/trailing whitespace.
# Empty lines and whole-line # comments are allowed; duplicate keys are not.
ENV=prod
DEBUG=false

# URL-encode special characters in database credentials; use utf8mb4.
DATABASE_URL=mysql+pymysql://__DB_USER__:__DB_PASSWORD__@__DB_HOST__:3306/__DB_NAME__?charset=utf8mb4
JWT_SECRET=__JWT_SECRET__
CORS_ORIGINS=__CORS_ORIGINS__

# Use separate, non-overlapping persistent absolute paths outside the checkout.
# Ensure the service user can access them; restrict private attachments.
UPLOAD_DIR=/__PUBLIC_UPLOAD_DIR__
PRIVATE_HOMEWORK_DIR=/__PRIVATE_HOMEWORK_DIR__
