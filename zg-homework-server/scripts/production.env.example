ENV=prod
DEBUG=false

# --- 数据库 ---
# MySQL。字符集必须 utf8mb4，否则中文与 emoji 会乱码。
# 若从 JDBC URL 转换：mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4
DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/homework_points?charset=utf8mb4
DB_ECHO=false

# --- JWT ---
# 生产环境务必修改；JWT 有效期 7 天
JWT_SECRET=需要ti'huan
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# --- 初始化种子 ---
# 首次启动时若无 admin 则创建；留空则随机生成并打印到日志
ADMIN_INIT_PASSWORD=

# --- CORS ---
# 允许的客户端来源，逗号分隔（Web 端地址）
CORS_ORIGINS=http://localhost:5173


# --- 文件上传 ---
UPLOAD_DIR=/var/lib/zg-homework/uploads
# 私有作业附件默认位于服务端目录下的 private_homework；生产环境建议使用持久化绝对路径。
PRIVATE_HOMEWORK_DIR=/var/lib/zg-homework/private_homework
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# --- 文章上传（迭代 v2.1：PDF / word）---
ARTICLE_ALLOWED_EXTENSIONS=pdf,docx
ARTICLE_MAX_UPLOAD_MB=10

# --- 安全 ---
# 注册接口限流：每分钟每 IP
REGISTER_RATE_LIMIT=10
# 签到/提交类接口限流：每分钟每用户
ACTION_RATE_LIMIT=10